<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_gica_peppol_sale_tree" model="ir.ui.view">
        <field name="name">gica.peppol.sale.tree</field>
        <field name="model">gica.peppol.sale</field>
        <field name="arch" type="xml">
	<tree string="Peppol Sales" create="0" edit="0" delete="0">
	    <field name="name"/>
	    <field name="invoice_date"/>
	    <field name="partner_id"/>
	    <field name="partner_vat"/>
	    <field name="amount_total"/>
	    <field name="currency_id"/>
	    <field name="peppol_status"/>
	    <field name="sent_date"/>
	    <field name="delivered_date"/>
	</tree>
        </field>
    </record>

    <record id="view_gica_peppol_sale_form" model="ir.ui.view">
        <field name="name">gica.peppol.sale.form</field>
        <field name="model">gica.peppol.sale</field>
        <field name="arch" type="xml">
            <form string="Peppol Sale" create="0" edit="1" delete="0">
	<header>
	    <button name="action_generate_xml"
		    type="object"
		    string="Generate XML"
		    class="btn-primary"
		    invisible="peppol_status != 'to_generate'"/>

	    <button name="action_reset_to_generate"
		    type="object"
		    string="Reset to To Generate"
		    class="btn-secondary"
		    invisible="not (peppol_status == 'error' and error_stage == 'generate')"/>

	    <button name="action_reset_to_send"
		    type="object"
		    string="Reset to To Send"
		    class="btn-secondary"
		    invisible="not ((peppol_status == 'error' and error_stage == 'send') or peppol_status == 'rejected')"/>
	</header>
                <sheet>
                    <group>
			    <field name="name" readonly="1"/>
			    <field name="move_id" readonly="1"/>
			    <field name="partner_id" readonly="1"/>
			    <field name="partner_vat" readonly="1"/>
			    <field name="invoice_date" readonly="1"/>
			    <field name="amount_total" readonly="1"/>
			    <field name="currency_id" readonly="1"/>
			    <field name="peppol_status" readonly="1"/>
			    <field name="sent_date" readonly="1"/>
			    <field name="sftp_filename" readonly="1"/>
			    <field name="delivered_date" readonly="1"/>
			    <field name="error_stage" invisible="1"/>
                            <field name="error_message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

	<record id="view_gica_peppol_sale_search" model="ir.ui.view">
		<field name="name">gica.peppol.sale.search</field>
		<field name="model">gica.peppol.sale</field>
		<field name="arch" type="xml">
			<search string="Peppol Sales">

				<filter name="to_generate"
						string="To Generate"
						domain="[('peppol_status','=','to_generate')]"/>

				<filter name="to_send"
						string="To Send"
						domain="[('peppol_status','=','to_send')]"/>

				<filter name="sent"
						string="Sent"
						domain="[('peppol_status','=','sent')]"/>

				<filter name="delivered"
						string="Delivered"
						domain="[('peppol_status','=','delivered')]"/>

				<filter name="rejected"
						string="Rejected"
						domain="[('peppol_status','=','rejected')]"/>

				<filter name="error"
						string="Error"
						domain="[('peppol_status','=','error')]"/>

				<group expand="0" string="Group By">
					<filter string="Status"
							name="group_status"
							context="{'group_by':'peppol_status'}"/>
				</group>

			</search>
		</field>
	</record>

</odoo>

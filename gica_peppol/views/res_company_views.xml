<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_gica_peppol" model="ir.ui.view">
        <field name="name">res.company.form.gica.peppol</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="GICA Peppol">
                    <field name="gica_peppol_xml_mode"/>
		    <field name="peppol_sftp_host"/>
		    <field name="peppol_sftp_port"/>
		    <field name="peppol_sftp_user"/>
		    <field name="peppol_sftp_private_key"/>
		</group>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LISTE -->

    <record id="view_gica_bank_statement_tree" model="ir.ui.view">
        <field name="name">gica.bank.statement.tree</field>
        <field name="model">gica.bank.statement</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
		<field name="date"/>
                <field name="journal_id"/>
                <field name="balance_start"/>
                <field name="balance_end"/>
                <field name="balance_difference"/>
		<field name="odoo_move_id" readonly="1"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- FORMULAIRE -->

    <record id="view_gica_bank_statement_form" model="ir.ui.view">
        <field name="name">gica.bank.statement.form</field>
        <field name="model">gica.bank.statement</field>
        <field name="arch" type="xml">
            <form string="GICA Bank Statement">

                <header>
		    <button
			name="action_open_items_wizard"
			type="object"
			string="Open Documents"
		    />

                    <button
                        name="action_validate"
                        type="object"
                        string="Validate"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>

                    <!-- ENTETE -->

                    <group>
                        <group>
                            <field name="journal_id"/>
                            <field name="name"/>
                            <field name="date"/>
                        </group>

                        <group>
                            <field name="balance_start"/>
                            <field name="balance_end"/>
                            <field name="balance_computed" readonly="1"/>
                            <field name="balance_difference" readonly="1"/>
                        </group>
                    </group>

                    <!-- LIGNES -->

                    <notebook>

                        <page string="Lines">

                            <field name="line_ids">

                                <tree editable="bottom">

                                    <field name="label"/>

                                    <field name="account_id"/>
                                    <field name="partner_id"/>

				    <field name="move_line_id" string="Document"/>

                                    <field name="amount"/>

                                    <field name="note"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                    <!-- TOTAUX -->

                    <group>
                        <group>
                            <field name="total_debit" readonly="1"/>
                            <field name="total_credit" readonly="1"/>
                        </group>
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <!-- ACTION -->

    <record id="action_gica_bank_statement" model="ir.actions.act_window">
        <field name="name">Bank Statements</field>
        <field name="res_model">gica.bank.statement</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>

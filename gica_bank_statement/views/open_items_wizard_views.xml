<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gica_open_items_wizard_form" model="ir.ui.view">
        <field name="name">gica.open.items.wizard.form</field>
        <field name="model">gica.open.items.wizard</field>
        <field name="arch" type="xml">

            <form string="Open Documents">

                <group>

                    <group>
                        <field name="statement_id" readonly="1"/>
                        <field name="partner_id"/>
                    </group>

                    <group>
                        <field name="selected_total" readonly="1"/>
                    </group>

                </group>

                <field name="wizard_line_ids">

                    <tree editable="bottom" create="0" delete="0">

                        <field name="selected"/>
			<field name="move_line_id" invisible="1" force_save="1"/>
                        <field name="date" readonly="1"/>
                        <field name="move_name" readonly="1"/>
                        <field name="name" readonly="1"/>
                        <field name="amount_residual" readonly="1"/>

                    </tree>

                </field>

                <footer>

                    <button
                        name="action_add_lines"
                        type="object"
                        string="Add"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                    />

                </footer>

            </form>

        </field>
    </record>

</odoo>

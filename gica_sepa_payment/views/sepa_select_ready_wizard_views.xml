<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gica_sepa_select_ready_wizard_form" model="ir.ui.view">
        <field name="name">gica.sepa.select.ready.wizard.form</field>
        <field name="model">gica.sepa.select.ready.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Ready Payment Lines">
                <group>
                    <field name="envelope_id" invisible="1"/>
                    <field name="available_partner_ids" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="overdue_before"/>
                    <field name="search_text"/>
                </group>

                <footer>
                    <button name="action_add"
                            type="object"
                            string="Select"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gica_sepa_move_info_tree" model="ir.ui.view">
        <field name="name">gica.sepa.move.info.tree</field>
        <field name="model">gica.sepa.move.info</field>
        <field name="arch" type="xml">
            <tree>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="amount_residual"/>
                <field name="discount_amount"/>
                <field name="deducted_amount"/>
                <field name="base_amount_to_pay"/>
                <field name="blocked"/>
            </tree>
        </field>
    </record>

    <record id="view_gica_sepa_move_info_form" model="ir.ui.view">
        <field name="name">gica.sepa.move.info.form</field>
        <field name="model">gica.sepa.move.info</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="move_id" string="Document" readonly="1"/>
                        <field name="move_line_id" invisible="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="invoice_date" readonly="1"/>
                        <field name="due_date" readonly="1"/>
                        <field name="amount_residual" readonly="1"/>
                    </group>
                    <group>
                        <field name="discount_amount"/>
                        <field name="discount_deadline"/>
                        <field name="deducted_amount" readonly="1"/>
                        <field name="base_amount_to_pay" readonly="1"/>
                    </group>
                    <group>
                        <field name="blocked"/>
                    </group>
                    <group>
                        <field name="litigation_note"/>
                        <field name="payment_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
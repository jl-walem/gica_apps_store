<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gica_sepa_payment_envelope_tree" model="ir.ui.view">
        <field name="name">gica.sepa.payment.envelope.tree</field>
        <field name="model">gica.sepa.payment.envelope</field>
        <field name="arch" type="xml">
            <tree string="Payment Envelopes">
                <field name="sepa_profile_id"/>
                <field name="name"/>
                <field name="date"/>
                <field name="company_id"  optional="hide"/>
                <field name="state"/>
                <field name="execution_date"/>
                <field name="sent_date_display"/>
                <field name="bank_execution_date"/>
                <field name="posted_date"/>
                <field name="line_count"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_gica_sepa_payment_envelope_form" model="ir.ui.view">
        <field name="name">gica.sepa.payment.envelope.form</field>
        <field name="model">gica.sepa.payment.envelope</field>
        <field name="arch" type="xml">
            <form string="Payment Envelope">
                <field name="xml_generated_date" invisible="1"/>
                <field name="xml_attachment_id" invisible="1"/>
                <field name="sent_date" invisible="1"/>
                <field name="bank_execution_date" invisible="1"/>
                <field name="posted_date" invisible="1"/>
                <header>
                    <button name="action_add_all_ready_payments"
                            type="object"
                            string="Add All"
                            class="btn-secondary"
                            invisible="state != 'draft' or not sepa_profile_id"/>

                    <button name="action_select_ready_payments"
                            type="object"
                            string="Select"
                            class="btn-secondary"
                            invisible="state != 'draft' or not sepa_profile_id"/>

                    <button name="action_add_manual_payment"
                            type="object"
                            string="Add"
                            class="btn-secondary"
                            invisible="state != 'draft' or not sepa_profile_id"/>

                    <button name="action_generate_xml"
                            type="object"
                            string="Generate XML"
                            class="btn-secondary"
                            invisible="state != 'confirmed' or xml_generated_date"/>
                    
                    <button name="action_open_xml_attachment"
                        type="object"
                        string="Open XML"
                        class="btn-secondary"
                        invisible="not xml_attachment_id"/>

                    <button name="action_mark_sent"
                            type="object"
                            string="Mark as Sent"
                            class="btn-secondary"
                            invisible="state != 'confirmed' or not xml_generated_date or sent_date"/>

                    <button name="action_mark_executed"
                            type="object"
                            string="Mark as Executed"
                            class="btn-secondary"
                            invisible="state != 'confirmed' or not sent_date or bank_execution_date"/>

                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft' or not sepa_profile_id"/>

                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state != 'confirmed'"/>
                    
                    <button name="action_post_accounting"
                        type="object"
                        string="Post Accounting"
                        class="btn-primary"
                        invisible="state != 'confirmed'
                                or not bank_execution_date
                                or account_move_id"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_account_move"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not account_move_id">
                            <field name="account_move_name"
                                widget="statinfo"
                                string="Accounting Entry"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="sepa_profile_id"
                                required="1"
                                readonly="state != 'draft'"/>
                            <field name="company_id"
                                readonly="state != 'draft'"/>
                            <field name="date"
                                readonly="state != 'draft'"/>
                            <field name="execution_date"
                                readonly="state != 'draft'"/>
                        </group>

                        <group string="Status Dates">
                            <field name="sent_date_display" readonly="1"/>
                            <field name="bank_execution_date" readonly="1"/>
                            <field name="posted_date" readonly="1"/>
                            <field name="account_move_id" invisible="1"/>
                            <field name="account_move_name" readonly="1"/>
                        </group>

                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Payment Lines">
                            <field name="line_ids" readonly="state != 'draft'">

                                <tree create="0" delete="1">
                                    
                                    <field name="available_move_info_ids" column_invisible="1"/>
                                    <field name="move_info_id"
                                        string="Document"
                                        domain="[('id', 'in', available_move_info_ids)]"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="invoice_date" string="Invoice Date" readonly="1"/>
                                    <field name="date_maturity" string="Due Date" readonly="1"/>
                                    <field name="invoice_total" string="Total" readonly="1"/>
                                    <field name="available_amount" string="To Pay" readonly="1"/>
                                    
                                    <field name="payment_amount" string="Payment"/>
                                    <field name="communication"/>
                                </tree>

                                <form string="Payment Line">
                                    <group>
                                        <field name="available_move_info_ids" invisible="1"/>
                                        <field name="move_info_id"
                                            string="Document"
                                            readonly="1"/>
                                        <field name="partner_id" readonly="1"/>
                                        <field name="amount_residual" readonly="1"/>
                                       
                                        <field name="payment_amount"/>
                                        <field name="communication"/>
                                        
                                    </group>
                                    <group string="Technical" invisible="1">
                                        <field name="company_id"/>
                                        <field name="move_line_id"/>
                                        <field name="move_id"/>
                                        <field name="invoice_date"/>
                                        <field name="date_maturity"/>
                                        <field name="communication_auto"/>
                                    </group>
                                </form>

                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gica_sepa_envelope" model="ir.actions.act_window">
        <field name="name">Payment Envelopes</field>
        <field name="res_model">gica.sepa.payment.envelope</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
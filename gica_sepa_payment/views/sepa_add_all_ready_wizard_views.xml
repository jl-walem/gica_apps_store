<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gica_sepa_add_all_ready_wizard_form" model="ir.ui.view">
        <field name="name">gica.sepa.add.all.ready.wizard.form</field>
        <field name="model">gica.sepa.add.all.ready.wizard</field>
        <field name="arch" type="xml">
            <form string="Add All Ready Payments">
                <sheet>
                    <field name="envelope_id" invisible="1"/>

                    <div class="alert alert-warning" role="alert">
                        This action will add all ready payment lines for the current company to this envelope.
                    </div>

                    <div class="text-muted">
                        This action is only allowed when the envelope does not contain any payment lines yet.
                    </div>
                </sheet>

                <footer>
                    <button name="action_add"
                            type="object"
                            string="Add"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gica_sepa_add_manual_payment_wizard_form" model="ir.ui.view">
        <field name="name">gica.sepa.add.manual.payment.wizard.form</field>
        <field name="model">gica.sepa.add.manual.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Payment">
                <group>
                    <field name="envelope_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="available_move_info_ids" invisible="1"/>
                    <field name="move_info_id"/>
                    <field name="available_amount"/>
                    <field name="payment_amount"/>
                </group>

                <footer>
                    <button name="action_add"
                            type="object"
                            string="Add"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>